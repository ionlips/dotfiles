[".local/bin/biome"]
executable = true
type = "file"

{{ if eq .chezmoi.os "darwin" -}}
url = "https://github.com/biomejs/biome/releases/download/%40biomejs%2Fbiome%402.6.5/biome-darwin-arm64"
{{- else -}}
url = "https://github.com/biomejs/biome/releases/download/%40biomejs%2Fbiome%402.6.5/biome-linux-x64-musl"
{{- end }}

[".local/bin/fd"]
executable = true
type = "archive-file"

{{ if eq .chezmoi.os "darwin" -}}
path = "fd-v10.4.2-aarch64-apple-darwin/fd"
url = "https://github.com/sharkdp/fd/releases/download/v10.4.2/fd-v10.4.2-aarch64-apple-darwin.tar.gz"
{{- else -}}
path = "fd-v10.4.2-x86_64-unknown-linux-musl/fd"
url = "https://github.com/sharkdp/fd/releases/download/v10.4.2/fd-v10.4.2-x86_64-unknown-linux-musl.tar.gz"
{{- end }}

