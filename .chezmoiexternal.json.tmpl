{
  ".local/bin/fd": {
    "executable": true,
    "type": "archive-file",
    {{ if eq .chezmoi.os "darwin" -}}
    "path": "fd-v10.4.2-aarch64-apple-darwin/fd",
    "url": "https://github.com/sharkdp/fd/releases/download/v10.4.2/fd-v10.4.2-aarch64-apple-darwin.tar.gz"
    {{- else -}}
    "path": "fd-v10.4.2-x86_64-unknown-linux-musl/fd",
    "url": "https://github.com/sharkdp/fd/releases/download/v10.4.2/fd-v10.4.2-x86_64-unknown-linux-musl.tar.gz"
    {{- end }}
  },
  ".local/bin/fzf": {
    "executable": true,
    "path": "fzf",
    "type": "archive-file",
    {{ if eq .chezmoi.os "darwin" -}}
    "url": "https://github.com/junegunn/fzf/releases/download/v0.74.1/fzf-0.74.1-darwin_arm64.tar.gz"
    {{- else -}}
    "url": "https://github.com/junegunn/fzf/releases/download/v0.74.1/fzf-0.74.1-linux_amd64.tar.gz"
    {{- end }}
  },
  ".local/bin/lazygit": {
    "executable": true,
    "path": "lazygit",
    "type": "archive-file",
    {{ if eq .chezmoi.os "darwin" -}}
    "url": "https://github.com/jesseduffield/lazygit/releases/download/v0.63.1/lazygit_0.63.1_darwin_arm64.tar.gz"
    {{- else -}}
    "url": "https://github.com/jesseduffield/lazygit/releases/download/v0.63.1/lazygit_0.63.1_linux_x86_64.tar.gz"
    {{- end }}
  },
  ".local/opt/node": {
    "stripComponents": 1,
    "type": "archive",
    {{ if eq .chezmoi.os "darwin" -}}
    "url": "https://nodejs.org/dist/v26.5.0/node-v26.5.0-darwin-arm64.tar.gz"
    {{- else -}}
    "url": "https://nodejs.org/dist/v26.5.0/node-v26.5.0-linux-x64.tar.xz"
    {{- end }}
  },
  ".local/opt/nvim": {
    "stripComponents": 1,
    "type": "archive",
    {{ if eq .chezmoi.os "darwin" -}}
    "url": "https://github.com/neovim/neovim/releases/download/v0.12.4/nvim-macos-arm64.tar.gz"
    {{- else -}}
    "url": "https://github.com/neovim/neovim/releases/download/v0.12.4/nvim-linux-x86_64.tar.gz"
    {{- end }}
  },
  ".local/bin/rg": {
    "executable": true,
    "type": "archive-file",
    {{ if eq .chezmoi.os "darwin" -}}
    "path": "ripgrep-15.2.0-aarch64-apple-darwin/rg",
    "url": "https://github.com/BurntSushi/ripgrep/releases/download/15.2.0/ripgrep-15.2.0-aarch64-apple-darwin.tar.gz"
    {{- else -}}
    "path": "ripgrep-15.2.0-x86_64-unknown-linux-musl/rg",
    "url": "https://github.com/BurntSushi/ripgrep/releases/download/15.2.0/ripgrep-15.2.0-x86_64-unknown-linux-musl.tar.gz"
    {{- end }}
  },
  ".local/bin/tree-sitter": {
    "executable": true,
    "type": "archive-file",
    "path": "tree-sitter",
    {{ if eq .chezmoi.os "darwin" -}}
    "url": "https://github.com/tree-sitter/tree-sitter/releases/download/v0.26.11/tree-sitter-cli-macos-arm64.zip"
    {{- else -}}
    "url": "https://github.com/tree-sitter/tree-sitter/releases/download/v0.26.11/tree-sitter-cli-linux-x64.zip"
    {{- end }}
  },
  ".local/bin/zk": {
    "executable": true,
    "path": "zk",
    "type": "archive-file",
    {{ if eq .chezmoi.os "darwin" -}}
    "url": "https://github.com/zk-org/zk/releases/download/v0.15.5/zk-v0.15.5-macos-arm64.tar.gz"
    {{- else -}}
    "url": "https://github.com/zk-org/zk/releases/download/v0.15.5/zk-v0.15.5-linux-amd64.tar.gz"
    {{- end }}
  }
}
