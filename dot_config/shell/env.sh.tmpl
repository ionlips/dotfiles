prepend() {
    local list
    eval "list=\${$1-}"
    list=":$list:"

    while [ "$list" != "${list//:$2:/:}" ]; do
        list="${list//:$2:/:}"
    done

    list="${list#:}"
    list="${list%:}"
    eval "$1=\"\$2\${list:+:\$list}\""
    export "$1"
}

# As per the XDG Base Directory Specification.
export XDG_CACHE_HOME=$HOME/.cache
export XDG_CONFIG_HOME=$HOME/.config
export XDG_DATA_HOME=$HOME/.local/share
export XDG_STATE_HOME=$HOME/.local/state

# Homebrew is only present on macOS.
{{ if eq .chezmoi.os "darwin" -}}
export HOMEBREW_CELLAR=/opt/homebrew/Cellar
export HOMEBREW_PREFIX=/opt/homebrew
export HOMEBREW_REPOSITORY=/opt/homebrew
prepend INFOPATH /opt/homebrew/share/info
prepend MANPATH /opt/homebrew/share/man
prepend PATH /opt/homebrew/sbin
prepend PATH /opt/homebrew/bin
{{- end }}

# Continue with system-agnositc locations.
prepend LD_LIBRARY_PATH $HOME/.local/lib
prepend MANPATH $HOME/.local/share/man
prepend MANPATH $HOME/.local/man
prepend PATH $HOME/.local/bin
prepend PKG_CONFIG_PATH $HOME/.local/lib/pkgconfig

# Add a trailing `:$INFOPATH` to ensure the system-determined config is set.
case $INFOPATH in
*:) ;;
*) INFOPATH=$INFOPATH: ;;
esac
export INFOPATH

# Add a trailing `:$MANPATH` to ensure the system-determined config is set.
case $MANPATH in
*:) ;;
*) MANPATH=$MANPATH: ;;
esac
export MANPATH

export CLAUDE_CONFIG_DIR=$XDG_CONFIG_HOME/claude
export EDITOR=nvim
export LESSHISTFILE=-
export MLFLOW_DISABLE_TELEMETRY=true
export NPM_CONFIG_USERCONFIG=$XDG_CONFIG_HOME/npm/npmrc
export NVM_DIR=$XDG_CONFIG_HOME/nvm
export STARSHIP_CONFIG=$XDG_CONFIG_HOME/starship/starship.toml
export ZK_NOTEBOOK_DIR=$HOME/notebook
